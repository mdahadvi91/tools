{
  "name": "ahadex-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AHADEX Tools — Free, fast and private online tools for everyday digital tasks.",
  "author": "AHADEX <mdahadvi91@gmail.com>",
  "license": "MIT",
  "homepage": "https://ahadex.online",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdahadvi91/tools.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vite",
    "generate:ssr": "tsx scripts/generate-ssr.ts",
    "prebuild": "tsx scripts/generate-ssr.ts && tsx scripts/generate-og-jpg.ts && tsx scripts/validate.ts",
    "validate": "tsx scripts/validate.ts",
    "ci": "npm run type-check && npm run generate:ssr && npm run validate && npm run test && npm run build",
    "check:drift": "git diff --exit-code functions/ public/sitemap.xml public/robots.txt public/images/og/ || (echo 'Generated files out of date' && exit 1)",
    "audit:content": "tsx scripts/content-audit.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^14.6.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.436.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.5.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
