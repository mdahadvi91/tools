/* ============================================================
 * SLIDER RANGES
 * ============================================================ */

export const SIZE_RANGE = {
  min: 10,
  max: 35,
  step: 1,
  default: 20,
};

export const PADDING_RANGE = {
  min: 0,
  max: 40,
  step: 1,
  default: 10,
};

/* ============================================================
 * FILE UPLOAD
 * ============================================================ */

export const MAX_FILE_SIZE = 50 * 1024 * 1024;

export const ACCEPTED_TYPES = [
  "image/jpeg",
  "image/png",
  "image/webp",
] as const;

export const ACCEPT_ATTR = ACCEPTED_TYPES.join(",");

function validateImageFile(file: File): void {
  if (!ACCEPTED_TYPES.includes(file.type as (typeof ACCEPTED_TYPES)[number])) {
    throw new Error("Only JPG, PNG, and WebP images are supported.");
  }

  if (file.size <= 0 || file.size > MAX_FILE_SIZE) {
    throw new Error("Image file must be between 1 byte and 50 MB.");
  }
}

/* ============================================================
 * IMAGE LOADING
 * ============================================================ */

export function loadImageFromFile(
  file: File,
): Promise<HTMLImageElement> {
  validateImageFile(file);

  return new Promise((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const img = new Image();

    const cleanup = () => {
      URL.revokeObjectURL(url);
      img.onload = null;
      img.onerror = null;
    };

    img.onload = () => {
      cleanup();

      if (
        !Number.isFinite(img.naturalWidth) ||
        !Number.isFinite(img.naturalHeight) ||
        img.naturalWidth <= 0 ||
        img.naturalHeight <= 0
      ) {
        reject(new Error("Invalid image dimensions."));
        return;
      }

      resolve(img);
    };

    img.onerror = () => {
      cleanup();
      reject(
        new Error(
          "The selected image could not be decoded. Try another image.",
        ),
      );
    };

    img.src = url;
  });
}

function validateImageDimensions(
  width: number,
  height: number,
): void {
  if (
    !Number.isSafeInteger(width) ||
    !Number.isSafeInteger(height) ||
    width <= 0 ||
    height <= 0
  ) {
    throw new Error("Invalid image dimensions.");
  }

  if (width > MAX_DIMENSION || height > MAX_DIMENSION) {
    throw new Error(
      `Image dimensions cannot exceed ${MAX_DIMENSION} pixels on either side.`,
    );
  }

  if (width * height > MAX_PIXELS) {
    throw new Error(
      "Image resolution is too large for reliable browser processing. Use an image with 16 megapixels or fewer.",
    );
  }
}

/* ============================================================
 * LOGO BUILDER
 * ============================================================ */

function buildLogoDataUrl(
  platform: PlatformConfig,
  size: number,
): string {
  const IconComponent = platform.Icon;

  const iconMarkup = renderToStaticMarkup(
    createElement(IconComponent, {
      size: 100,
      color: "#FFFFFF",
      strokeWidth: 2.5,
    }),
  );

  const svg = `
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="${size}"
      height="${size}"
      viewBox="0 0 100 100"
    >
      <circle cx="50" cy="50" r="50" fill="${platform.color}"/>
      <g transform="translate(25, 25)">
        ${iconMarkup
          .replace(/width="[^"]*"/g, 'width="50"')
          .replace(/height="[^"]*"/g, 'height="50"')}
      </g>
    </svg>
  `;

  const bytes = new TextEncoder().encode(svg);
  let binary = "";

  for (const byte of bytes) {
    binary += String.fromCharCode(byte);
  }

  return `data:image/svg+xml;base64,${btoa(binary)}`;
}

function loadSvgImage(
  dataUrl: string,
): Promise<HTMLImageElement> {
  return new Promise((resolve, reject) => {
    const img = new Image();

    img.onload = () => resolve(img);
    img.onerror = () =>
      reject(new Error("Could not render QR logo."));

    img.src = dataUrl;
  });
}

/* ============================================================
 * GEOMETRY
 * ============================================================ */

function roundRect(
  ctx: CanvasRenderingContext2D,
  x: number,
  y: number,
  width: number,
  height: number,
  radius: number,
): void {
  const r = Math.max(
    0,
    Math.min(radius, width / 2, height / 2),
  );

  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + width - r, y);
  ctx.quadraticCurveTo(x + width, y, x + width, y + r);
  ctx.lineTo(x + width, y + height - r);
  ctx.quadraticCurveTo(
    x + width,
    y + height,
    x + width - r,
    y + height,
  );
  ctx.lineTo(x + r, y + height);
  ctx.quadraticCurveTo(x, y + height, x, y + height - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

interface Layout {
  qrSize: number;
  padding: number;
  totalBox: number;
  inset: number;
  x: number;
  y: number;
}

function getPositionCoords(
  position: Position,
  width: number,
  height: number,
  totalBox: number,
  inset: number,
): { x: number; y: number } {
  const maxX = Math.max(0, width - totalBox - inset);
  const maxY = Math.max(0, height - totalBox - inset);

  switch (position) {
    case "top-left":
      return { x: inset, y: inset };

    case "top-right":
      return { x: maxX, y: inset };

    case "bottom-left":
      return { x: inset, y: maxY };

    case "bottom-right":
    default:
      return { x: maxX, y: maxY };
  }
}

function createLayout(
  width: number,
  height: number,
  position: Position,
  sizePercent: number,
  requestedPadding: number,
  background: QrBackground,
): Layout {
  const safeSizePercent = Math.min(
    SIZE_RANGE.max,
    Math.max(SIZE_RANGE.min, Number(sizePercent) || SIZE_RANGE.default),
  );

  const safePadding = Math.min(
    PADDING_RANGE.max,
    Math.max(0, Number(requestedPadding) || 0),
  );

  const minSide = Math.min(width, height);
  const qrSize = Math.round((minSide * safeSizePercent) / 100);

  if (qrSize < MIN_QR_SIZE) {
    throw new Error(
      `The QR code would be too small to scan reliably. Use a larger photo or increase the QR size. Minimum QR size: ${MIN_QR_SIZE}px.`,
    );
  }

  const inset = Math.max(8, Math.round(qrSize * 0.04));

  const maxPadding = Math.max(
    0,
    Math.floor((minSide - qrSize - inset * 2) / 2),
  );

  const padding =
    background === "none"
      ? 0
      : Math.min(safePadding, maxPadding);

  const totalBox = qrSize + padding * 2;

  if (totalBox + inset * 2 > minSide) {
    throw new Error(
      "The QR code does not fit inside this image. Reduce its size or use a larger photo.",
    );
  }

  const { x, y } = getPositionCoords(
    position,
    width,
    height,
    totalBox,
    inset,
  );

  if (
    x < 0 ||
    y < 0 ||
    x + totalBox > width ||
    y + totalBox > height
  ) {
    throw new Error(
      "QR placement is outside the image boundaries. Adjust the size or padding.",
    );
  }

  return {
    qrSize,
    padding,
    totalBox,
    inset,
    x,
    y,
  };
}

/* ============================================================
 * QR GENERATION
 * ============================================================ */

export async function generateQrWithLogo(
  payload: string,
  platform: PlatformConfig,
  qrPixelSize: number,
): Promise<HTMLCanvasElement> {
  const safePayload = validatePayload(payload);

  if (
    !Number.isFinite(qrPixelSize) ||
    qrPixelSize < MIN_QR_SIZE ||
    qrPixelSize > MAX_DIMENSION
  ) {
    throw new Error(
      `QR image size must be between ${MIN_QR_SIZE} and ${MAX_DIMENSION} pixels.`,
    );
  }

  const qrCanvas = document.createElement("canvas");

  try {
    await QRCode.toCanvas(qrCanvas, safePayload, {
      width: Math.floor(qrPixelSize),
      margin: 4,
      errorCorrectionLevel: "H",
      color: {
        dark: "#0A0B1E",
        light: "#FFFFFF",
      },
    });
  } catch {
    throw new Error(
      "This information could not fit into a QR code. Shorten the content and try again.",
    );
  }

  const ctx = qrCanvas.getContext("2d");

  if (!ctx) {
    throw new Error("Could not initialize QR canvas.");
  }

  // Keep the logo smaller to reduce interference with QR modules.
  const logoSize = Math.round(qrCanvas.width * 0.16);
  const logoDataUrl = buildLogoDataUrl(platform, logoSize);
  const logoImg = await loadSvgImage(logoDataUrl);

  const plateSize = Math.round(logoSize * 1.2);
  ctx.save();
  ctx.beginPath();
  ctx.arc(
    qrCanvas.width / 2,
    qrCanvas.height / 2,
    plateSize / 2,
    0,
    Math.PI * 2,
  );
  ctx.fillStyle = "#FFFFFF";
  ctx.fill();
  ctx.restore();

  ctx.drawImage(
    logoImg,
    (qrCanvas.width - logoSize) / 2,
    (qrCanvas.height - logoSize) / 2,
    logoSize,
    logoSize,
  );

  return qrCanvas;
}

/* ============================================================
 * BACKGROUND
 * ============================================================ */

function drawQrBackground(
  ctx: CanvasRenderingContext2D,
  background: QrBackground,
  x: number,
  y: number,
  totalBox: number,
): void {
  if (background === "none") return;

  ctx.save();

  if (background === "rounded") {
    roundRect(
      ctx,
      x,
      y,
      totalBox,
      totalBox,
      Math.min(totalBox * 0.12, 48),
    );
  } else {
    ctx.beginPath();
    ctx.rect(x, y, totalBox, totalBox);
  }

  ctx.fillStyle = "#FFFFFF";
  ctx.fill();
  ctx.restore();
}

/* ============================================================
 * PAYLOAD RESOLUTION
 * ============================================================ */

function resolvePayload(
  platform: PlatformConfig,
  values: Record<string, string>,
): string {
  try {
    return validatePayload(platform.buildPayload(values));
  } catch (error) {
    if (error instanceof Error) throw error;

    throw new Error("Could not validate QR information.");
  }
}

/* ============================================================
 * RENDER PIPELINE
 * ============================================================ */

async function renderPhoto(
  options: RenderOptions,
  maxPreviewSize?: number,
): Promise<HTMLCanvasElement> {
  const {
    photoFile,
    platform,
    values,
    position,
    sizePercent,
    padding,
    qrBackground,
  } = options;

  const payload = resolvePayload(platform, values);
  const img = await loadImageFromFile(photoFile);

  validateImageDimensions(img.naturalWidth, img.naturalHeight);

  const originalWidth = img.naturalWidth;
  const originalHeight = img.naturalHeight;

  const scale = maxPreviewSize
    ? Math.min(
        1,
        maxPreviewSize /
          Math.max(originalWidth, originalHeight),
      )
    : 1;

  const width = Math.max(1, Math.round(originalWidth * scale));
  const height = Math.max(1, Math.round(originalHeight * scale));

  validateImageDimensions(width, height);

  const layout = createLayout(
    width,
    height,
    position,
    sizePercent,
    padding * scale,
    qrBackground,
  );

  const qrCanvas = await generateQrWithLogo(
    payload,
    platform,
    layout.qrSize,
  );

  const output = document.createElement("canvas");
  output.width = width;
  output.height = height;

  const ctx = output.getContext("2d");

  if (!ctx) {
    throw new Error("Could not initialize image canvas.");
  }

  // JPEG cannot preserve transparency. Use white as its base.
  if (maxPreviewSize || true) {
    ctx.fillStyle = "#FFFFFF";
    ctx.fillRect(0, 0, width, height);
  }

  ctx.drawImage(img, 0, 0, width, height);

  drawQrBackground(
    ctx,
    qrBackground,
    layout.x,
    layout.y,
    layout.totalBox,
  );

  ctx.drawImage(
    qrCanvas,
    layout.x + layout.padding,
    layout.y + layout.padding,
    layout.qrSize,
    layout.qrSize,
  );

  return output;
}

/* ============================================================
 * COMPOSE FULL RESOLUTION PHOTO
 * ============================================================ */

export async function composePhoto(
  options: RenderOptions,
  format: "image/png" | "image/jpeg" = "image/png",
): Promise<Blob> {
  const output = await renderPhoto(options);

  return new Promise((resolve, reject) => {
    try {
      output.toBlob(
        (blob) => {
          output.width = 0;
          output.height = 0;

          if (!blob || blob.size === 0) {
            reject(new Error("Failed to export the image."));
            return;
          }

          resolve(blob);
        },
        format,
        format === "image/jpeg" ? 0.92 : undefined,
      );
    } catch {
      output.width = 0;
      output.height = 0;
      reject(new Error("Image export failed."));
    }
  });
}

/* ============================================================
 * GENERATE LOW-RES PREVIEW
 * ============================================================ */

export async function generatePreview(
  options: RenderOptions,
  maxPreviewSize = 1200,
): Promise<string> {
  if (
    !Number.isFinite(maxPreviewSize) ||
    maxPreviewSize < MIN_QR_SIZE ||
    maxPreviewSize > 4_000
  ) {
    throw new Error("Invalid preview dimensions.");
  }

  const output = await renderPhoto(options, maxPreviewSize);

  try {
    return output.toDataURL("image/png");
  } catch {
    throw new Error("Could not create the image preview.");
  } finally {
    output.width = 0;
    output.height = 0;
  }
}
