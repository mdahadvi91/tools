import {
  useCallback,
  useEffect,
  useId,
  useMemo,
  useRef,
  useState,
} from "react";
import {
  ArrowLeft,
  ArrowRight,
  Download,
  Loader2,
  X,
  Layers,
  Settings2,
  ImageIcon,
  Upload,
} from "lucide-react";
import { useLanguage } from "@contexts/LanguageContext";
import { cn } from "@lib/cn";
import {
  getPlatform,
  composePhoto,
  generatePreview,
  PLATFORMS,
  POSITIONS,
  QR_BACKGROUNDS,
  SIZE_RANGE,
  PADDING_RANGE,
  MAX_FILE_SIZE,
  ACCEPTED_TYPES,
  ACCEPT_ATTR,
} from "./logic";
import type { Position, QrBackground } from "./logic";
import { tools } from "@/data/tools";

const photoQrData = tools.find((tool) => tool.id === "photo-qr");
const TOOL_SLUG = photoQrData?.slug ?? "photo-qr";

type DownloadFormat = "image/png" | "image/jpeg";
type WizardStep = 1 | 2 | 3 | 4;

interface PhotoQRWizardModalProps {
  isOpen: boolean;
  onClose: () => void;
}

const INITIAL_VALUES: Record<string, string> = {};

export function PhotoQRWizardModal({
  isOpen,
  onClose,
}: PhotoQRWizardModalProps) {
  const { language } = useLanguage();
  const bn = language === "bn";

  const titleId = useId();
  const descriptionId = useId();
  const uploadInputId = useId();

  const dialogRef = useRef<HTMLDivElement>(null);
  const closeButtonRef = useRef<HTMLButtonElement>(null);
  const fileInputRef = useRef<HTMLInputElement>(null);
  const previousFocusRef = useRef<HTMLElement | null>(null);

  const timerRef = useRef<number | null>(null);
  const requestRef = useRef(0);
  const downloadUrlRef = useRef<string | null>(null);

  const [step, setStep] = useState<WizardStep>(1);
  const [photoFile, setPhotoFile] = useState<File | null>(null);
  const [platformId, setPlatformId] = useState("whatsapp");
  const [values, setValues] = useState<Record<string, string>>(
    INITIAL_VALUES,
  );

  const [position, setPosition] =
    useState<Position>("bottom-right");
  const [sizePercent, setSizePercent] = useState(20);
  const [padding, setPadding] = useState(10);
  const [qrBackground, setQrBackground] =
    useState<QrBackground>("rounded");

  const [preview, setPreview] = useState<string | null>(null);
  const [generating, setGenerating] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [downloading, setDownloading] = useState(false);
  const [downloadFormat, setDownloadFormat] =
    useState<DownloadFormat>("image/png");
  const [isDragging, setIsDragging] = useState(false);

  const platform = useMemo(
    () => getPlatform(platformId) ?? getPlatform("whatsapp"),
    [platformId],
  );

  const payload = useMemo(() => {
    if (!platform) return "";

    try {
      return platform.buildPayload(values).trim();
    } catch {
      return "";
    }
  }, [platform, values]);

  const canProceed1 = Boolean(photoFile);
  const canProceed2 = Boolean(photoFile && platform && payload);

  const stepTitles: Record<WizardStep, string> = {
    1: bn ? "ছবি আপলোড করুন" : "Upload Photo",
    2: bn ? "প্ল্যাটফর্ম ও তথ্য" : "Platform & Details",
    3: bn ? "ডিজাইন স্টাইল" : "Design Style",
    4: bn ? "ডাউনলোড" : "Download",
  };

  const clearDownloadUrl = useCallback(() => {
    if (downloadUrlRef.current) {
      URL.revokeObjectURL(downloadUrlRef.current);
      downloadUrlRef.current = null;
    }
  }, []);

  const resetWizard = useCallback(() => {
    requestRef.current += 1;

    if (timerRef.current !== null) {
      window.clearTimeout(timerRef.current);
      timerRef.current = null;
    }

    clearDownloadUrl();

    setStep(1);
    setPhotoFile(null);
    setPlatformId("whatsapp");
    setValues({});
    setPosition("bottom-right");
    setSizePercent(20);
    setPadding(10);
    setQrBackground("rounded");
    setPreview(null);
    setGenerating(false);
    setError(null);
    setDownloading(false);
    setDownloadFormat("image/png");
    setIsDragging(false);
  }, [clearDownloadUrl]);

  const handleClose = useCallback(() => {
    resetWizard();
    onClose();
  }, [onClose, resetWizard]);

  useEffect(() => {
    if (!isOpen) return;

    previousFocusRef.current =
      document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null;

    const frame = window.requestAnimationFrame(() => {
      closeButtonRef.current?.focus();
    });

    return () => {
      window.cancelAnimationFrame(frame);
      previousFocusRef.current?.focus();
    };
  }, [isOpen]);

  useEffect(() => {
    if (!isOpen) return;

    const handleKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        event.preventDefault();
        handleClose();
        return;
      }

      if (event.key !== "Tab" || !dialogRef.current) return;

      const focusable = dialogRef.current.querySelectorAll<HTMLElement>(
        [
          "button:not([disabled])",
          "input:not([disabled]):not([type='hidden'])",
          "select:not([disabled])",
          "textarea:not([disabled])",
          "[href]",
          '[tabindex]:not([tabindex="-1"])',
        ].join(","),
      );

      const elements = Array.from(focusable).filter(
        (element) => element.offsetParent !== null,
      );

      if (elements.length === 0) {
        event.preventDefault();
        return;
      }

      const first = elements[0];
      const last = elements[elements.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (
        !event.shiftKey &&
        document.activeElement === last
      ) {
        event.preventDefault();
        first.focus();
      }
    };

    document.addEventListener("keydown", handleKeyDown);

    return () => {
      document.removeEventListener("keydown", handleKeyDown);
    };
  }, [isOpen, handleClose]);

  useEffect(() => {
    if (!isOpen || !photoFile || !payload || !platform) {
      setPreview(null);
      setGenerating(false);
      return;
    }

    const requestId = ++requestRef.current;

    if (timerRef.current !== null) {
      window.clearTimeout(timerRef.current);
      timerRef.current = null;
    }

    setGenerating(true);
    setError(null);

    timerRef.current = window.setTimeout(async () => {
      try {
        const nextPreview = await generatePreview({
          photoFile,
          platform,
          values,
          position,
          sizePercent,
          padding,
          qrBackground,
        });

        if (requestRef.current === requestId) {
          setPreview(nextPreview);
          setError(null);
        }
      } catch (cause) {
        if (requestRef.current === requestId) {
          setPreview(null);
          setError(
            cause instanceof Error
              ? cause.message
              : bn
                ? "প্রিভিউ তৈরি করা যায়নি।"
                : "Could not generate preview.",
          );
        }
      } finally {
        if (requestRef.current === requestId) {
          setGenerating(false);
        }
      }
    }, 180);

    return () => {
      if (timerRef.current !== null) {
        window.clearTimeout(timerRef.current);
        timerRef.current = null;
      }

      if (requestRef.current === requestId) {
        requestRef.current += 1;
      }
    };
  }, [
    isOpen,
    photoFile,
    platform,
    values,
    position,
    sizePercent,
    padding,
    qrBackground,
    payload,
    bn,
  ]);

  useEffect(() => {
    return () => {
      if (timerRef.current !== null) {
        window.clearTimeout(timerRef.current);
      }

      clearDownloadUrl();
    };
  }, [clearDownloadUrl]);

  const handleFiles = useCallback(
    (files: FileList | null) => {
      if (!files || files.length === 0) return;

      const file = files[0];

      if (!ACCEPTED_TYPES.some((type) => type === file.type)) {
        setError(
          bn
            ? "শুধু JPG, PNG অথবা WebP ছবি নির্বাচন করুন।"
            : "Please select a JPG, PNG, or WebP image.",
        );
        return;
      }

      if (file.size > MAX_FILE_SIZE) {
        setError(
          bn
            ? "ফাইলের আকার সর্বোচ্চ ৫০ MB হতে পারবে।"
            : "File is too large. Maximum size is 50 MB.",
        );
        return;
      }

      if (file.size === 0) {
        setError(
          bn ? "ছবির ফাইলটি খালি।" : "The selected file is empty.",
        );
        return;
      }

      requestRef.current += 1;
      setPhotoFile(file);
      setPreview(null);
      setError(null);
    },
    [bn],
  );

  const handlePlatformChange = (id: string) => {
    setPlatformId(id);
    setValues({});
    setError(null);
    setPreview(null);
  };

  const handleDownload = async () => {
    if (!photoFile || !payload || !platform || downloading) return;

    setDownloading(true);
    setError(null);

    try {
      const blob = await composePhoto(
        {
          photoFile,
          platform,
          values,
          position,
          sizePercent,
          padding,
          qrBackground,
        },
        downloadFormat,
      );

      if (!(blob instanceof Blob) || blob.size === 0) {
        throw new Error(
          bn
            ? "ডাউনলোড ফাইল তৈরি করা যায়নি।"
            : "The output file could not be created.",
        );
      }

      clearDownloadUrl();

      const url = URL.createObjectURL(blob);
      downloadUrlRef.current = url;

      const anchor = document.createElement("a");
      const extension =
        downloadFormat === "image/png" ? "png" : "jpg";

      anchor.href = url;
      anchor.download = `${TOOL_SLUG}-${Date.now()}.${extension}`;
      anchor.style.display = "none";

      document.body.appendChild(anchor);
      anchor.click();
      anchor.remove();

      // Give the browser time to start the download before revoking.
      window.setTimeout(() => {
        if (downloadUrlRef.current === url) {
          URL.revokeObjectURL(url);
          downloadUrlRef.current = null;
        }
      }, 10_000);
    } catch (cause) {
      setError(
        cause instanceof Error
          ? cause.message
          : bn
            ? "ডাউনলোড ব্যর্থ হয়েছে। আবার চেষ্টা করুন।"
            : "Download failed. Please try again.",
      );
    } finally {
      setDownloading(false);
    }
  };

  const nextStep = () => {
    setError(null);

    if (step === 1 && canProceed1) setStep(2);
    if (step === 2 && canProceed2) setStep(3);
    if (step === 3 && canProceed2) setStep(4);
  };

  const previousStep = () => {
    setError(null);
    setStep((current) => {
      if (current === 4) return 3;
      if (current === 3) return 2;
      if (current === 2) return 1;
      return 1;
    });
  };

  if (!isOpen) return null;

  return (
    <div
      className="fixed inset-0 z-[100] flex items-center justify-center bg-black/60 backdrop-blur-sm p-0 sm:p-4"
      onMouseDown={(event) => {
        if (event.target === event.currentTarget) handleClose();
      }}
    >
      <div
        ref={dialogRef}
        role="dialog"
        aria-modal="true"
        aria-labelledby={titleId}
        aria-describedby={descriptionId}
        className="flex h-full w-full flex-col overflow-hidden border border-silk-rose/25 bg-white shadow-2xl dark:bg-[#0A0B1E] sm:h-auto sm:max-h-[90vh] sm:max-w-5xl sm:rounded-2xl"
      >
        <header className="flex shrink-0 items-center justify-between gap-3 border-b border-silk-rose/20 bg-white px-4 py-3 dark:bg-[#0A0B1E]">
          <div className="min-w-0">
            <p className="text-[10px] font-bold uppercase tracking-widest text-silk-rose">
              {bn ? `ধাপ ${step}/4` : `STEP ${step}/4`}
            </p>

            <h2
              id={titleId}
              className="truncate text-base font-bold text-light-text dark:text-dark-text sm:text-lg"
            >
              {stepTitles[step]}
            </h2>

            <p id={descriptionId} className="sr-only">
              {bn
                ? "ছবির উপর QR কোড তৈরি করার চার ধাপের প্রক্রিয়া।"
                : "Four-step process to create a QR code on your photo."}
            </p>
          </div>

          <button
            ref={closeButtonRef}
            type="button"
            onClick={handleClose}
            aria-label={bn ? "বন্ধ করুন" : "Close"}
            className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-silk-rose/10 text-silk-wine transition hover:bg-silk-rose/20 dark:bg-silk-rose/15 dark:text-silk-rose"
          >
            <X className="h-5 w-5" aria-hidden="true" />
          </button>
        </header>

        <div className="flex min-h-0 flex-1 flex-col md:flex-row">
          {/* Live preview stays above the settings on mobile. */}
          <section
            aria-label={bn ? "লাইভ প্রিভিউ" : "Live preview"}
            className="flex min-h-[220px] max-h-[38vh] shrink-0 items-center justify-center overflow-hidden border-b border-silk-rose/15 bg-gray-100 p-3 dark:bg-gray-900 sm:min-h-[260px] md:max-h-none md:min-h-0 md:w-1/2 md:border-b-0 md:border-r md:p-5"
          >
            {photoFile && preview ? (
              <img
                src={preview}
                alt={
                  bn
                    ? "ছবির উপর QR কোডের প্রিভিউ"
                    : "Preview of the QR code on your photo"
                }
                className="max-h-full max-w-full rounded-lg object-contain shadow-sm"
              />
            ) : generating ? (
              <div
                className="flex flex-col items-center gap-2 text-light-textSecondary dark:text-dark-textSecondary"
                role="status"
                aria-live="polite"
              >
                <Loader2
                  className="h-6 w-6 animate-spin"
                  aria-hidden="true"
                />
                <p className="text-xs">
                  {bn ? "প্রিভিউ তৈরি হচ্ছে..." : "Generating preview..."}
                </p>
              </div>
            ) : (
              <div className="text-center text-light-textSecondary dark:text-dark-textSecondary">
                <ImageIcon
                  className="mx-auto mb-2 h-10 w-10 opacity-50"
                  aria-hidden="true"
                />
                <p className="px-4 text-xs">
                  {bn
                    ? "ছবি আপলোড করলে এখানে প্রিভিউ দেখাবে"
                    : "Upload a photo to see the preview here"}
                </p>
              </div>
            )}
          </section>

          <div className="flex min-h-0 flex-1 flex-col bg-white dark:bg-[#0A0B1E] md:w-1/2">
            <div className="flex-1 overflow-y-auto p-4 sm:p-6">
              {step === 1 && (
                <section aria-labelledby={`${titleId}-upload`}>
                  <h3 id={`${titleId}-upload`} className="sr-only">
                    {bn ? "ছবি আপলোড" : "Upload photo"}
                  </h3>

                  {photoFile ? (
                    <div className="space-y-3 text-center">
                      <p className="text-sm font-bold text-light-text dark:text-dark-text">
                        ✓ {bn ? "ছবি নির্বাচন করা হয়েছে" : "Photo selected"}
                      </p>

                      <p className="truncate text-xs text-light-textSecondary dark:text-dark-textSecondary">
                        {photoFile.name}
                      </p>

                      <p className="text-xs text-light-textSecondary dark:text-dark-textSecondary">
                        {(photoFile.size / (1024 * 1024)).toFixed(2)} MB
                      </p>

                      <button
                        type="button"
                        onClick={() => fileInputRef.current?.click()}
                        className="text-sm font-bold text-silk-rose hover:underline"
                      >
                        {bn ? "অন্য ছবি নির্বাচন করুন" : "Choose another photo"}
                      </button>
                    </div>
                  ) : (
                    <div
                      onDragOver={(event) => {
                        event.preventDefault();
                        setIsDragging(true);
                      }}
                      onDragLeave={(event) => {
                        if (
                          !event.currentTarget.contains(
                            event.relatedTarget as Node | null,
                          )
                        ) {
                          setIsDragging(false);
                        }
                      }}
                      onDrop={(event) => {
                        event.preventDefault();
                        setIsDragging(false);
                        handleFiles(event.dataTransfer.files);
                      }}
                      className={cn(
                        "group relative flex cursor-pointer flex-col items-center justify-center gap-4 rounded-2xl border-2 border-dashed p-8 transition-colors",
                        isDragging
                          ? "border-silk-rose bg-silk-rose/10"
                          : "border-silk-rose/30 hover:border-silk-rose/50",
                      )}
                    >
                      <input
                        ref={fileInputRef}
                        id={uploadInputId}
                        type="file"
                        accept={ACCEPT_ATTR}
                        onChange={(event) => {
                          handleFiles(event.currentTarget.files);
                          event.currentTarget.value = "";
                        }}
                        className="sr-only"
                      />

                      <label
                        htmlFor={uploadInputId}
                        className="flex w-full cursor-pointer flex-col items-center gap-4"
                      >
                        <span className="flex h-14 w-14 items-center justify-center rounded-2xl bg-silk-rose/10">
                          <Upload
                            className="h-6 w-6 text-silk-rose"
                            aria-hidden="true"
                          />
                        </span>

                        <span className="text-center">
                          <span className="block font-bold text-light-text dark:text-dark-text">
                            {bn ? "ছবি নির্বাচন করুন" : "Choose a photo"}
                          </span>

                          <span className="mt-1 block text-xs text-light-textSecondary dark:text-dark-textSecondary">
                            {bn
                              ? "JPG, PNG, WebP · সর্বোচ্চ ৫০ MB"
                              : "JPG, PNG, WebP · Maximum 50 MB"}
                          </span>
                        </span>
                      </label>
                    </div>
                  )}

                  {error && (
                    <p
                      className="mt-3 text-center text-xs text-red-600 dark:text-red-400"
                      role="alert"
                    >
                      {error}
                    </p>
                  )}
                </section>
              )}

              {step === 2 && (
                <section className="space-y-5">
                  <div>
                    <div className="mb-2 flex items-center gap-2">
                      <Layers
                        className="h-4 w-4 text-silk-rose"
                        aria-hidden="true"
                      />
                      <h3 className="text-sm font-bold text-light-text dark:text-dark-text">
                        {bn ? "প্ল্যাটফর্ম" : "Platform"}
                      </h3>
                    </div>

                    <div className="grid grid-cols-3 gap-2 sm:grid-cols-4">
                      {PLATFORMS.map((item) => {
                        const active = item.id === platformId;
                        const PlatformIcon = item.Icon;

                        return (
                          <button
                            key={item.id}
                            type="button"
                            onClick={() => handlePlatformChange(item.id)}
                            aria-pressed={active}
                            className={cn(
                              "flex flex-col items-center gap-1.5 rounded-xl border p-2 transition-colors",
                              active
                                ? "border-silk-rose/50 bg-silk-rose/15"
                                : "border-silk-rose/15 bg-silk-rose/5 hover:border-silk-rose/40",
                            )}
                          >
                            <span
                              className="flex h-8 w-8 items-center justify-center rounded-lg"
                              style={{
                                backgroundColor: `${item.color}20`,
                                color: item.color,
                              }}
                            >
                              <PlatformIcon aria-hidden="true" />
                            </span>

                            <span className="w-full truncate text-center text-[10px] font-bold leading-tight text-light-text dark:text-dark-text">
                              {bn ? item.nameBn : item.name}
                            </span>
                          </button>
                        );
                      })}
                    </div>
                  </div>

                  <div>
                    <div className="mb-2 flex items-center gap-2">
                      <Settings2
                        className="h-4 w-4 text-silk-rose"
                        aria-hidden="true"
                      />
                      <h3 className="text-sm font-bold text-light-text dark:text-dark-text">
                        {bn ? "তথ্য" : "Details"}
                      </h3>
                    </div>

                    <div className="space-y-3">
                      {platform?.fields.map((field) => {
                        const inputId = `${titleId}-${field.key}`;

                        return (
                          <div key={field.key}>
                            <label
                              htmlFor={inputId}
                              className="mb-1.5 block text-xs font-bold text-light-text dark:text-dark-text"
                            >
                              {bn ? field.labelBn : field.label}
                            </label>

                            <input
                              id={inputId}
                              type={field.type}
                              value={values[field.key] ?? ""}
                              onChange={(event) => {
                                setValues((current) => ({
                                  ...current,
                                  [field.key]: event.target.value,
                                }));
                                setError(null);
                              }}
                              placeholder={
                                bn ? field.placeholderBn : field.placeholder
                              }
                              autoComplete="off"
                              className="h-11 w-full rounded-xl border border-silk-rose/20 bg-white px-3 text-sm text-light-text outline-none transition focus:border-silk-rose/60 focus:ring-2 focus:ring-silk-rose/20 dark:bg-[#0A0B1E] dark:text-dark-text"
                            />
                          </div>
                        );
                      })}
                    </div>
                  </div>

                  {error && (
                    <p className="text-xs text-red-600 dark:text-red-400" role="alert">
                      {error}
                    </p>
                  )}
                </section>
              )}

              {step === 3 && (
                <section className="space-y-5">
                  <div>
                    <h3 className="mb-2 text-sm font-bold text-light-text dark:text-dark-text">
                      📍 {bn ? "অবস্থান" : "Position"}
                    </h3>

                    <div className="grid grid-cols-2 gap-2 sm:grid-cols-4">
                      {POSITIONS.map((item) => {
                        const active = position === item.id;

                        return (
                          <button
                            key={item.id}
                            type="button"
                            onClick={() => setPosition(item.id)}
                            aria-pressed={active}
                            className={cn(
                              "h-10 rounded-xl border text-xs font-bold transition-colors",
                              active
                                ? "border-silk-rose/50 bg-silk-rose/15 text-silk-wine dark:text-silk-rose-soft"
                                : "border-silk-rose/15 bg-silk-rose/5 text-light-textSecondary hover:border-silk-rose/40 dark:text-dark-textSecondary",
                            )}
                          >
                            {bn ? item.labelBn : item.label}
                          </button>
                        );
                      })}
                    </div>
                  </div>

                  <div>
                    <div className="mb-2 flex items-center justify-between">
                      <label
                        htmlFor={`${titleId}-size`}
                        className="text-sm font-bold text-light-text dark:text-dark-text"
                      >
                        {bn ? "সাইজ" : "Size"}
                      </label>

                      <output
                        htmlFor={`${titleId}-size`}
                        className="rounded bg-silk-rose/10 px-2 py-0.5 font-mono text-sm font-bold text-silk-rose"
                      >
                        {sizePercent}%
                      </output>
                    </div>

                    <input
                      id={`${titleId}-size`}
                      type="range"
                      min={SIZE_RANGE.min}
                      max={SIZE_RANGE.max}
                      step={SIZE_RANGE.step}
                      value={sizePercent}
                      onChange={(event) =>
                        setSizePercent(Number(event.target.value))
                      }
                      className="w-full accent-silk-rose"
                    />
                  </div>

                  <div>
                    <div className="mb-2 flex items-center justify-between">
                      <label
                        htmlFor={`${titleId}-padding`}
                        className="text-sm font-bold text-light-text dark:text-dark-text"
                      >
                        {bn ? "প্যাডিং" : "Padding"}
                      </label>

                      <output
                        htmlFor={`${titleId}-padding`}
                        className="rounded bg-silk-rose/10 px-2 py-0.5 font-mono text-sm font-bold text-silk-rose"
                      >
                        {padding}px
                      </output>
                    </div>

                    <input
                      id={`${titleId}-padding`}
                      type="range"
                      min={PADDING_RANGE.min}
                      max={PADDING_RANGE.max}
                      step={PADDING_RANGE.step}
                      value={padding}
                      onChange={(event) =>
                        setPadding(Number(event.target.value))
                      }
                      className="w-full accent-silk-rose"
                    />
                  </div>

                  <div>
                    <h3 className="mb-2 text-sm font-bold text-light-text dark:text-dark-text">
                      🎨 {bn ? "ব্যাকগ্রাউন্ড" : "Background"}
                    </h3>

                    <div className="grid grid-cols-3 gap-2">
                      {QR_BACKGROUNDS.map((item) => {
                        const active = qrBackground === item.id;
                        const BackgroundIcon = item.Icon;

                        return (
                          <button
                            key={item.id}
                            type="button"
                            onClick={() => setQrBackground(item.id)}
                            aria-pressed={active}
                            className={cn(
                              "flex h-10 items-center justify-center gap-1 rounded-xl border text-xs font-bold transition-colors",
                              active
                                ? "border-silk-rose/50 bg-silk-rose/15 text-silk-wine dark:text-silk-rose-soft"
                                : "border-silk-rose/15 bg-silk-rose/5 text-light-textSecondary hover:border-silk-rose/40 dark:text-dark-textSecondary",
                            )}
                          >
                            <BackgroundIcon
                              className="h-4 w-4"
                              aria-hidden="true"
                            />
                            <span>{bn ? item.labelBn : item.label}</span>
                          </button>
                        );
                      })}
                    </div>
                  </div>
                </section>
              )}

              {step === 4 && (
                <section className="space-y-4">
                  <div className="text-center">
                    <p className="mb-1 text-sm font-bold text-light-text dark:text-dark-text">
                      ✓ {bn ? "প্রস্তুত" : "Ready"}
                    </p>

                    <p className="mb-4 text-xs text-light-textSecondary dark:text-dark-textSecondary">
                      {bn ? "ফাইল ফরম্যাট বেছে নিন" : "Choose file format"}
                    </p>
                  </div>

                  <div className="flex gap-3">
                    <button
                      type="button"
                      onClick={() => setDownloadFormat("image/png")}
                      aria-pressed={downloadFormat === "image/png"}
                      className={cn(
                        "flex-1 rounded-xl border-2 py-3 font-bold transition-colors",
                        downloadFormat === "image/png"
                          ? "border-silk-rose bg-silk-rose/10 text-silk-wine dark:text-silk-rose"
                          : "border-silk-rose/20 text-light-textSecondary hover:border-silk-rose/40 dark:text-dark-textSecondary",
                      )}
                    >
                      PNG
                      <span className="mt-0.5 block text-[10px] font-normal opacity-70">
                        {bn ? "স্বচ্ছতা সমর্থন করে" : "Supports transparency"}
                      </span>
                    </button>

                    <button
                      type="button"
                      onClick={() => setDownloadFormat("image/jpeg")}
                      aria-pressed={downloadFormat === "image/jpeg"}
                      className={cn(
                        "flex-1 rounded-xl border-2 py-3 font-bold transition-colors",
                        downloadFormat === "image/jpeg"
                          ? "border-silk-rose bg-silk-rose/10 text-silk-wine dark:text-silk-rose"
                          : "border-silk-rose/20 text-light-textSecondary hover:border-silk-rose/40 dark:text-dark-textSecondary",
                      )}
                    >
                      JPG
                      <span className="mt-0.5 block text-[10px] font-normal opacity-70">
                        {bn ? "ছোট ফাইল হতে পারে" : "Can produce smaller files"}
                      </span>
                    </button>
                  </div>

                  {error && (
                    <p className="text-center text-xs text-red-600 dark:text-red-400" role="alert">
                      {error}
                    </p>
                  )}
                </section>
              )}
            </div>

            <footer className="flex shrink-0 items-center justify-between gap-3 border-t border-silk-rose/20 bg-white px-4 py-3 dark:bg-[#0A0B1E]">
              {step > 1 ? (
                <button
                  type="button"
                  onClick={previousStep}
                  className="flex items-center gap-2 rounded-xl border border-silk-rose/30 px-4 py-3 text-sm font-bold text-light-text transition hover:bg-silk-rose/5 dark:text-dark-text"
                >
                  <ArrowLeft className="h-4 w-4" aria-hidden="true" />
                  {bn ? "পিছনে" : "Back"}
                </button>
              ) : (
                <span />
              )}

              {step < 4 && (
                <button
                  type="button"
                  onClick={nextStep}
                  disabled={
                    (step === 1 && !canProceed1) ||
                    (step === 2 && !canProceed2) ||
                    (step === 3 && !canProceed2)
                  }
                  className="flex min-h-12 items-center gap-2 rounded-xl bg-red-600 px-6 py-3 text-sm font-bold text-white shadow-md transition-colors hover:bg-red-700 active:bg-red-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:focus-visible:ring-offset-[#0A0B1E] disabled:cursor-not-allowed disabled:bg-gray-400 disabled:opacity-60"
                >
                  {step === 3
                    ? bn
                      ? "ডাউনলোড"
                      : "Download"
                    : bn
                      ? "পরবর্তী"
                      : "Next"}

                  <ArrowRight className="h-4 w-4" aria-hidden="true" />
                </button>
              )}

              {step === 4 && (
                <button
                  type="button"
                  onClick={handleDownload}
                  disabled={downloading || generating || !canProceed2}
                  className="flex items-center gap-2 rounded-xl bg-silk-rose px-6 py-3 text-sm font-bold text-white transition hover:bg-silk-wine disabled:cursor-not-allowed disabled:opacity-50"
                >
                  {downloading ? (
                    <Loader2
                      className="h-4 w-4 animate-spin"
                      aria-hidden="true"
                    />
                  ) : (
                    <Download className="h-4 w-4" aria-hidden="true" />
                  )}

                  {downloading
                    ? bn
                      ? "তৈরি হচ্ছে..."
                      : "Preparing..."
                    : bn
                      ? "ডাউনলোড"
                      : "Download"}
                </button>
              )}
            </footer>
          </div>
        </div>
      </div>
    </div>
  );
}
